.DEFAULT_GOAL := all
WONDERFUL_TOOLCHAIN ?= /opt/wonderful
PREFIX := $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/arm-none-eabi-
RTS_BUILD := $(if $(filter 1,$(PICO_RTS_ARM7_CAPTURE)),$(if $(filter 1,$(PICO_RTS_VIDEO_CAPTURE)),$(if $(filter 1,$(PICO_RTS_RESTORE_PROBE)),build/rts-worker-p4,build/rts-worker-m32),build/rts-worker-m3),build/rts-worker)
ifeq ($(PICO_RTS_ARM7_CAPTURE),1)
RTS_EXTRA_FLAGS := -DPICO_RTS_ARM7_CAPTURE
RTS_EXTRA_OBJ := $(RTS_BUILD)/arm7-capture.o
endif
ifeq ($(PICO_RTS_VIDEO_CAPTURE),1)
RTS_EXTRA_FLAGS += -DPICO_RTS_VIDEO_CAPTURE
RTS_EXTRA_OBJ += $(RTS_BUILD)/video-capture.o
endif
ifeq ($(PICO_RTS_RESTORE_PROBE),1)
RTS_MODE := -mthumb
RTS_IDENTITY_INPUTS := arm9/source/patches/rts/RtsProbe.cpp arm9/source/patches/rts/RtsProbe7.s arm9/source/patches/rts/RtsProbe9.s arm9/source/patches/rts/RtsSoundHooks7.s common/RtsP4.h common/RtsP4Profile.h common/RtsSnapshotInfo.h common/RtsSavePath.c common/RtsSha256.c arm7/source/loader/NdsLoader.cpp arm7/source/loader/RtsSnapshotPrepare.cpp
RTS_EXTRA_FLAGS += -DPICO_RTS_RESTORE_PROBE
RTS_EXTRA_OBJ += $(addprefix $(RTS_BUILD)/,arm9-cpu-capture.o arm9-state-restore.o arm7-restore.o arm9-continuation.o arm7-restore-validator.o sound-restart.o sound-observer.o p4-arm7.o p4-arm7-entry.o p4-load.o)
endif
RTS_FLAGS := -mcpu=arm946e-s -marm -Os -ffreestanding -fno-builtin -fno-jump-tables -fno-stack-protector -fno-pic -fno-tree-loop-distribute-patterns -ffunction-sections -fdata-sections -Icommon -Wall -Wextra

$(RTS_BUILD)/worker.o $(RTS_EXTRA_OBJ): $(wildcard common/Rts*.h)

.PHONY: all
all: $(RTS_BUILD)/RtsM2Image.h

$(RTS_BUILD)/worker.o: runtime/rts/worker.c common/RtsSnapshotInfo.h common/RtsArm7Capture.h common/RtsVideoCapture.h runtime/rts/worker-state.h common/RtsP4.h
	mkdir -p $(RTS_BUILD)
	$(PREFIX)gcc $(RTS_FLAGS) $(RTS_MODE) $(RTS_EXTRA_FLAGS) -std=c17 -c $< -o $@

$(RTS_BUILD)/video-capture.o: runtime/rts/video-capture.c common/RtsVideoCapture.h runtime/rts/worker-state.h common/RtsP4.h
	mkdir -p $(RTS_BUILD)
	$(PREFIX)gcc $(RTS_FLAGS) $(RTS_MODE) -std=c17 -c $< -o $@

$(RTS_BUILD)/arm9-cpu-capture.o: runtime/rts/arm9-cpu-capture.s
	$(PREFIX)gcc $(RTS_FLAGS) -c $< -o $@
$(RTS_BUILD)/arm9-state-restore.o: runtime/rts/arm9-state-restore.s
	$(PREFIX)gcc $(RTS_FLAGS) -c $< -o $@
$(RTS_BUILD)/arm7-restore.o: runtime/rts/arm7-restore.s
	$(PREFIX)gcc -mcpu=arm7tdmi -marm -c $< -o $@
$(RTS_BUILD)/arm9-continuation.o: runtime/rts/arm9-continuation.c
	$(PREFIX)gcc $(RTS_FLAGS) -mthumb $(RTS_EXTRA_FLAGS) -c $< -o $@
$(RTS_BUILD)/arm7-restore-validator.o: runtime/rts/arm7-restore.c
	$(PREFIX)gcc $(RTS_FLAGS) -mthumb -c $< -o $@
$(RTS_BUILD)/sound-restart.o: runtime/rts/sound-restart.c
	$(PREFIX)gcc -mcpu=arm7tdmi -mthumb -mthumb-interwork -fno-jump-tables -Os -ffreestanding -fno-builtin -ffunction-sections -fdata-sections -Icommon -c $< -o $@
$(RTS_BUILD)/sound-observer.o: runtime/rts/sound-observer.c
	$(PREFIX)gcc -mcpu=arm7tdmi -mthumb -mthumb-interwork -fno-jump-tables -Os -ffreestanding -fno-builtin -ffunction-sections -fdata-sections -Icommon -c $< -o $@
$(RTS_BUILD)/p4-arm7.o: runtime/rts/p4-arm7.c
	$(PREFIX)gcc -mcpu=arm7tdmi -mthumb -mthumb-interwork -fno-jump-tables -Os -ffreestanding -fno-builtin -ffunction-sections -fdata-sections -Icommon -c $< -o $@
$(RTS_BUILD)/p4-arm7-entry.o: runtime/rts/p4-arm7-entry.s
	$(PREFIX)gcc -mcpu=arm7tdmi -marm -c $< -o $@
$(RTS_BUILD)/p4-load.o: runtime/rts/p4-load.c
	$(PREFIX)gcc $(RTS_FLAGS) -mthumb $(RTS_EXTRA_FLAGS) -fstack-usage -c $< -o $@

$(RTS_BUILD)/entry.o: runtime/rts/worker-entry.s
	mkdir -p $(RTS_BUILD)
	$(PREFIX)gcc $(RTS_FLAGS) -c $< -o $@

$(RTS_BUILD)/arm7-capture.o: runtime/rts/arm7-capture.s
	mkdir -p $(RTS_BUILD)
	$(PREFIX)gcc -mcpu=arm7tdmi -marm -c $< -o $@

$(RTS_BUILD)/worker.elf: $(RTS_BUILD)/entry.o $(RTS_BUILD)/worker.o $(RTS_EXTRA_OBJ) runtime/rts/worker.ld
	$(PREFIX)gcc -mcpu=arm946e-s -marm -nostdlib -Wl,--emit-relocs,--gc-sections,--build-id=none -T runtime/rts/worker.ld $(RTS_BUILD)/entry.o $(RTS_BUILD)/worker.o $(RTS_EXTRA_OBJ) -o $@

$(RTS_BUILD)/RtsM2Image.h: $(RTS_BUILD)/worker.elf tools/build_rts_image.py $(RTS_IDENTITY_INPUTS)
	python tools/build_rts_image.py $< $@ $(PREFIX)
